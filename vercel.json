{
  "rewrites": [
    { "source": "/admin", "destination": "/api/server?p=/admin" },
    { "source": "/admin/:path*", "destination": "/api/server?p=/admin/:path*" },
    { "source": "/api/:path+", "destination": "/api/server?p=/api/:path+" }
  ],
  "functions": {
    "api/server.js": {
      "includeFiles": "{admin/**,demo-data/**,src/content.json,scripts/lib/**}"
    }
  }
}
